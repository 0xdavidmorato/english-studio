{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "ui-shared/src",
    "outDir": ".test-dist",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["ui-shared/src/**/*.ts", "ui-shared/src/**/*.tsx"]
}
